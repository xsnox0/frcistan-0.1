<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>frcistan.ico</ApplicationIcon>
    <!-- yayimlama ve kurulum ciktilari Solution Explorer'da gozukmesin -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;kurulum-cikti\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

</Project>
